{
  "rewrites": [
    { "source": "/os", "destination": "/os.html" },
    { "source": "/os/", "destination": "/os.html" },
    { "source": "/srl", "destination": "/srl.html" },
    { "source": "/srl/", "destination": "/srl.html" },
